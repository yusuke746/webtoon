# このファイルをコピーして .env を作成し、値を埋めてください。
#   cp .env.example .env        （Windows: copy .env.example .env）
# .env / .env.local は .gitignore 済みでコミットされません。
# 優先順位: シェルの環境変数 > .env.local > .env

# ---- Replicate（作画） -------------------------------------------------
# https://replicate.com/account/api-tokens で発行（"r8_" で始まる）
# 空 or 未設定なら自動で mock 画像生成にフォールバックします。
REPLICATE_API_TOKEN=

# 画風が未設定のときに使うフォールバックモデル
# REPLICATE_MODEL=black-forest-labs/flux-schnell

# replicate / mock を明示指定（未設定なら REPLICATE_API_TOKEN の有無で自動判定）
# IMAGE_CLIENT=replicate

# ---- LoRA学習（任意 / 実費と時間がかかります） -------------------------
# 学習モデルは version 必須（owner/name:versionId）。下は 2026-07-28 時点の最新版。
# 最新版は GET https://api.replicate.com/v1/models/ostris/flux-dev-lora-trainer で確認できます。
# REPLICATE_LORA_TRAINER=ostris/flux-dev-lora-trainer:26dce37af90b9d997eeb970d92e47de3064d46c300504ae376c75bef6a9022d2

# 学習結果の出力先。Replicate 上で «事前にモデルを作成» しておく必要があります。
# REPLICATE_LORA_DESTINATION=your-name/my-manga-lora

# ---- テキスト生成（Claude CLI） ---------------------------------------
# claude（CLI サブプロセス） / mock（開発用）
# LLM_CLIENT=claude
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_MODEL=
# LLM_TIMEOUT_MS=300000
# DISCUSSION_ROUNDS=2

# ---- サーバー ----------------------------------------------------------
# PORT=3001
# DATA_DIR=./data
